{
  "manifest_version": 3,
  "name": "Multichat Stickers",
  "description": "Добавляет стикеры из мультичата в чат YouTube и Twitch. Создано специально для канала Гля Бокопор",
  "version": "0.1.3.0",
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.twitch.tv/*",
    "https://misakamibot.ru/*"
  ],
  "background": {  
    "service_worker": "background.js"  
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.twitch.tv/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/NotoColorEmoji.ttf",
        "lib/*",
        "tgs-sticker.html"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.twitch.tv/*"
      ]
    }
  ],
  "permissions": [
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}